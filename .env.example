# PostgreSQL (API backend)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# API server
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET=change-me-to-a-long-random-secret-min-16-chars
JWT_EXPIRES_IN=never

# Rate limiting
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_API=300

# Desktop cloud mode — point each POS machine at the API host (use LAN IP for other PCs)
CLOUD_API_URL=http://localhost:3001

# SQLite (desktop local DB — optional override for CLI tooling)
# DATABASE_PATH=./data/mama-babi.db
