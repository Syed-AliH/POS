{
  "name": "@mama-babi/desktop",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Mama Babi POS Desktop Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "bundle-api": "node scripts/bundle-api.mjs",
    "prepare-secrets": "node scripts/prepare-secrets.mjs",
    "dist": "node scripts/bundle-api.mjs && node scripts/prepare-secrets.mjs && electron-vite build && electron-builder",
    "dist:win": "node scripts/bundle-api.mjs && node scripts/prepare-secrets.mjs && electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= CSC_LINK= electron-builder --win",
    "dist:publish": "node scripts/bundle-api.mjs && node scripts/prepare-secrets.mjs && electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= CSC_LINK= electron-builder --win --publish always",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.8.9",
    "postgres": "^3.4.9",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@mama-babi/barcode": "workspace:*",
    "@mama-babi/db-schema": "workspace:*",
    "@mama-babi/printer": "workspace:*",
    "@mama-babi/reports": "workspace:*",
    "@mama-babi/sync-engine": "workspace:*",
    "@mama-babi/ui": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.mamababi.pos",
    "productName": "Mama Babi POS",
    "copyright": "Copyright © 2026 Mama Babi",
    "icon": "build-resources/icon.png",
    "directories": {
      "output": "C:\\Temp\\mamababi-build",
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/config.json"
    ],
    "extraResources": [
      {
        "from": "resources/preload.cjs",
        "to": "preload.cjs"
      },
      {
        "from": "resources/config.json",
        "to": "config.json"
      },
      {
        "from": "resources/secrets.json",
        "to": "secrets.json"
      },
      {
        "from": "api-bundle",
        "to": "api"
      }
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Mama Babi",
      "verifyUpdateCodeSignature": false,
      "sign": "./build-scripts/nullSign.cjs",
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mama Babi POS",
      "menuCategory": "Mama Babi",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "Syed-AliH",
      "repo": "POS",
      "releaseType": "release"
    }
  }
}
