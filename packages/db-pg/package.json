{
  "name": "@mama-babi/db-pg",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "sync-sku-prefixes": "tsx src/run-sync-sku-prefixes.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "bootstrap": "tsx src/bootstrap-from-local.ts",
    "enable-rls": "tsx src/enable-rls.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mama-babi/barcode": "workspace:*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.14.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
